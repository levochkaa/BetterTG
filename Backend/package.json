{
    "name": "bettertg-backend",
    "version": "0.1.0",
    "private": true,
    "description": "BetterTG rich push relay backend",
    "license": "UNLICENSED",
    "engines": {
        "bun": ">=1.4.0"
    },
    "packageManager": "bun@1.4.0",
    "scripts": {
        "build": "nest build && tsc-alias -p tsconfig.build.json",
        "dev": "bun --watch src/main.ts",
        "dev:worker": "bun --watch src/worker.ts",
        "start": "bun dist/main.js",
        "start:worker": "bun dist/worker.js",
        "lint": "tsc --noEmit && eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:coverage": "bun test --coverage",
        "migration:show": "bun run build && bunx typeorm migration:show -d dist/database/data-source.js",
        "migration:run": "bun run build && bunx typeorm migration:run -d dist/database/data-source.js",
        "migration:run:prod": "bunx typeorm migration:run -d dist/database/data-source.js",
        "migration:revert": "bun run build && bunx typeorm migration:revert -d dist/database/data-source.js",
        "catalog:update": "bun scripts/update-telegram-push-catalog.mjs",
        "smoke:relay": "bun scripts/smoke-relay.mjs"
    },
    "dependencies": {
        "@nestjs/bullmq": "11.0.5",
        "@nestjs/common": "11.2.1",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.2.1",
        "@nestjs/platform-express": "11.2.1",
        "@nestjs/swagger": "11.4.7",
        "@nestjs/terminus": "11.1.1",
        "@nestjs/typeorm": "11.0.3",
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/auto-instrumentations-node": "0.79.0",
        "@opentelemetry/core": "2.10.0",
        "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
        "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
        "@opentelemetry/sdk-metrics": "2.10.0",
        "@opentelemetry/sdk-node": "0.221.0",
        "appattest-checker-node": "1.0.3",
        "bullmq": "6.2.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "17.4.2",
        "fast-jwt": "6.3.2",
        "helmet": "8.3.0",
        "http_ece": "1.2.1",
        "ioredis": "5.11.1",
        "pg": "8.23.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typeorm": "1.1.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@nestjs/cli": "11.0.24",
        "@nestjs/testing": "11.2.1",
        "@types/bun": "1.4.0",
        "@types/express": "5.0.6",
        "@types/node": "26.2.0",
        "@types/supertest": "7.2.1",
        "eslint": "10.9.0",
        "prettier": "3.9.6",
        "supertest": "7.2.2",
        "tsc-alias": "1.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.67.0"
    }
}
