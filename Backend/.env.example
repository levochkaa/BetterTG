NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:8080

DATABASE_URL=postgresql://bettertg:bettertg@localhost:5433/bettertg
REDIS_URL=redis://localhost:6380/0
# Optional Compose overrides for external services.
DOCKER_DATABASE_URL=postgresql://bettertg:bettertg@postgres:5432/bettertg
DOCKER_REDIS_URL=redis://redis:6379/0

BUNDLE_ID=com.levochkaaa.BetterTG
APPLE_TEAM_ID=7Z2WHPKU8W
APPLE_KEY_ID=
APPLE_AUTH_KEY=
APNS_DRY_RUN=true
APNS_SANDBOX_URL=https://api.sandbox.push.apple.com
APNS_PRODUCTION_URL=https://api.push.apple.com
APNS_REQUEST_TIMEOUT_MS=10000

# Comma-separated key-id:base64-encoded-32-byte-key entries.
ENCRYPTION_CURRENT_KEY_ID=dev
ENCRYPTION_KEYS=dev:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MANAGEMENT_TOKEN_PEPPER=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Production requires "enforce". "bypass" is accepted only outside production.
APP_ATTEST_MODE=bypass
APP_ATTEST_ALLOW_DEVELOPMENT=true

OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
SWAGGER_ENABLED=true
